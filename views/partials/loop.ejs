<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>News Listing</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            bgMain: '#E8FFD7',
            bgCard: '#93DA97',
            accent: '#5E936C',
            textPrimary: '#3E5F44'
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>

<body class="bg-bgMain text-textPrimary min-h-screen">

  <main class="max-w-5xl mx-auto px-4 py-8 space-y-6">

    <h1 class="text-3xl font-bold mb-4">Latest News</h1>

    <% news = paginatedNews.data %>
    <% news.forEach(function(article){ %>
      <div class="bg-bgCard rounded-lg shadow-md overflow-hidden md:flex flex-col md:flex-row">
        <a class="block md:w-1/3" href="/single/<%= article._id %>">
          <img src="/uploads/<%= article.image %>" alt="<%= article.title %>" class="w-full h-48 md:h-full object-cover">
        </a>
        <div class="p-4 md:w-2/3 flex flex-col justify-between">
          <div>
            <h3 class="text-xl font-bold mb-2">
              <a href="/single/<%= article._id %>" class="hover:text-accent transition"><%= article.title %></a>
            </h3>
            <div class="text-sm mb-2 flex flex-wrap gap-4">
              <span><i class="fa fa-tags"></i> <a href="/category/<%= article.category.slug %>" class="hover:text-accent transition"><%= article.category.name %></a></span>
              <span><i class="fa fa-user"></i> <a href="/author/<%= article.author._id %>" class="hover:text-accent transition"><%= article.author.fullname %></a></span>
              <span><i class="fa fa-calendar"></i> <% var date = new Date(article.createdAt); %> <%= date.toLocaleDateString("en-US", { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
            </div>
            <p class="mb-2"><%= article.content.substring(0,30) + '...' %></p>
          </div>
          <div class="mt-auto">
            <a href="/single/<%= article._id %>" class="inline-block mt-2 bg-accent text-white px-4 py-2 rounded hover:bg-textPrimary transition">Read More</a>
          </div>
        </div>
      </div>
    <% }) %>

    <!-- Pagination -->
    <%
    function buildQuery(query, pagge){
      const params = new URLSearchParams(query);
      params.set('page', pagge);
      return '?' + params.toString();
    }
    %>

    <nav class="mt-6 flex justify-center flex-wrap gap-1">
      <a class="px-3 py-1 rounded border border-green-700 <%= paginatedNews.hasPrevPage ? 'bg-accent text-white hover:bg-textPrimary' : 'opacity-50 cursor-not-allowed' %>" href="<%= buildQuery(query, paginatedNews.prevPage) %>">Previous</a>
      <% for(let i=1; i<=paginatedNews.totalPages; i++){ 
        let activeClass = paginatedNews.currentPage == i ? "bg-accent text-white" : "bg-bgCard text-textPrimary hover:bg-accent hover:text-white";
      %>
        <a class="px-3 py-1 rounded border border-green-700 <%= activeClass %>" href="<%= buildQuery(query, i) %>"><%= i %></a>
      <% } %>
      <a class="px-3 py-1 rounded border border-green-700 <%= paginatedNews.hasNextPage ? 'bg-accent text-white hover:bg-textPrimary' : 'opacity-50 cursor-not-allowed' %>" href="<%= buildQuery(query, paginatedNews.nextPage) %>">Next</a>
    </nav>

  </main>

</body>
</html>
