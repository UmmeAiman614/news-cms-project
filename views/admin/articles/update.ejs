<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Update Article</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            bgMain: '#E8FFD7',
            bgCard: '#93DA97',
            accent: '#5E936C',
            textPrimary: '#3E5F44'
          }
        }
      }
    }
  </script>
  <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet">
</head>
<body class="bg-bgMain text-textPrimary min-h-screen flex flex-col">

  <!-- Main Content -->
  <main class="flex-grow p-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl font-bold text-center mb-6">Update Article</h1>

      <div class="bg-bgCard shadow-lg rounded-lg p-6">
        <form action="/admin/update-article/<%= article.id %>" method="POST" enctype="multipart/form-data" class="space-y-4">

          <!-- Title -->
          <div>
            <label for="article_title" class="block font-semibold">Title</label>
            <input type="text" name="title" id="article_title" value="<%= article.title %>"
              class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent"
              autocomplete="off" required>
          </div>

          <!-- Description -->
          <div>
            <label for="summernote" class="block font-semibold">Description</label>
            <textarea name="content" id="summernote"
              class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent"
              rows="5" required><%= article.content %></textarea>
          </div>

          <!-- Category -->
          <div>
            <label for="article_category" class="block font-semibold">Category</label>
            <select name="category" id="article_category"
              class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent">
              <% categories.forEach(category=> { %>
                <% if (article.category.id==category.id) { %>
                  <option value="<%= category.id %>" selected><%= category.name %></option>
                <% } else { %>
                  <option value="<%= category.id %>"><%= category.name %></option>
                <% } %>
              <% }) %>
            </select>
          </div>

          <!-- Article Image -->
          <div>
            <label for="article_image" class="block font-semibold">Article Image</label>
            <img src="/uploads/<%= article.image %>" alt=""
              class="mb-3 w-32 sm:w-40 border-2 border-accent rounded-md">
            <input type="file" name="image" id="article_image"
              class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent">
          </div>

          <!-- Submit Button -->
          <div class="text-center">
            <button type="submit"
              class="bg-accent text-white px-5 py-2 rounded hover:bg-textPrimary transition">
              Update
            </button>
          </div>

        </form>

        <!-- Error message -->
        <div class="mt-4">
          <%- include ('../partials/error') %>
        </div>
      </div>
    </div>
  </main>

  <!-- Scripts -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
  <script>
    $(document).ready(function () {
      $('#summernote').summernote({
        placeholder: 'Start typing...',
        tabsize: 2,
        height: 200
      });
    });

    document.querySelector('form').addEventListener('submit', function () {
      const unwantedField = document.querySelector('input[name="files"]');
      if (unwantedField) {
        unwantedField.remove();
      }
    });
  </script>
</body>
</html>
