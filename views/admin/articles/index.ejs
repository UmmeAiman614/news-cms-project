<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All Articles</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            bgMain: '#E8FFD7',
            bgCard: '#93DA97',
            accent: '#5E936C',
            textPrimary: '#3E5F44'
          }
        }
      }
    }
  </script>
  <link href="https://unpkg.com/tabulator-tables@6.0.0/dist/css/tabulator.min.css" rel="stylesheet">
  <script src="https://unpkg.com/tabulator-tables@6.0.0/dist/js/tabulator.min.js"></script>
</head>
<body class="bg-bgMain text-textPrimary min-h-screen flex flex-col">

<main class="flex-grow p-4">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
      <h1 class="text-3xl font-bold flex items-center gap-2">
        <i class="fa fa-file-text"></i> All Articles
      </h1>
      <a href="/admin/add-article"
         class="bg-accent text-white px-4 py-2 rounded hover:bg-textPrimary transition w-full md:w-auto text-center">
        Add New Article
      </a>
    </div>

    <!-- Table container with horizontal scroll for small screens -->
    <div class="bg-bgCard rounded-lg shadow p-4 w-full md:w-5xl overflow-x-auto">
      <div id="articlesTable" class="w-full"></div>
    </div>
  </div>
</main>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const tableData = <%- JSON.stringify(articles) %>;

  const isSmallScreen = window.innerWidth < 768;

  const table = new Tabulator("#articlesTable", {
    data: tableData,
    layout: "fitDataStretch",
    responsiveLayout: isSmallScreen ? "collapse" : false, // collapse only on small screens
    pagination: true,
    paginationSize: 10,
    paginationSizeSelector: [5, 10, 25, 50, 100],
    resizableColumns: true,
    rowFormatter: function(row) {
      const index = row.getPosition(true);
      const el = row.getElement();
      el.style.backgroundColor = index % 2 === 0 ? "#93DA97" : "#C2E8C5";
      el.style.color = "#3E5F44";

      el.addEventListener("mouseenter", () => {
        el.style.backgroundColor = "#5E936C";
        el.style.color = "#fff";
      });
      el.addEventListener("mouseleave", () => {
        el.style.backgroundColor = index % 2 === 0 ? "#93DA97" : "#C2E8C5";
        el.style.color = "#3E5F44";
      });
    },
    columns: [
      { title: "S.No.", formatter: "rownum", hozAlign: 'center', width: 80 },
      { title: "Title", field: "title", headerFilter: 'input', minWidth: 150 },
      { title: "Category", field: "category.name", headerFilter: 'input', minWidth: 120 },
      { title: "Date", field: "createdAt", headerFilter: 'input', minWidth: 120,
        formatter: (cell) => new Date(cell.getValue()).toDateString()
      },
      { title: "Author", field: "author.fullname", headerFilter: 'input', minWidth: 120 },
      {
        title: "Actions",
        field: "actions",
        hozAlign: "center",
        headerSort: false,
        minWidth: 180,
        formatter: (cell) => {
          const id = cell.getRow().getData()._id;
          return `
            <div class="flex flex-row gap-1 justify-center">
              <a href="/admin/update-article/${id}" class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700 transition">Edit</a>
              <button onclick="deleteArticle('${id}')" class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700 transition">Delete</button>
            </div>
          `;
        }
      }
    ],
  });

  async function deleteArticle(id) {
    if (confirm("Are you sure to delete this Article?")) {
      const response = await fetch(`/admin/delete-article/${id}`, { method: "DELETE" });
      if (response.ok) {
        window.location.reload();
      } else {
        alert("Failed to delete article.");
      }
    }
  }

  window.addEventListener("resize", () => {
    const small = window.innerWidth < 768;
    table.setResponsiveLayout(small ? "collapse" : false);
    table.redraw(true);
  });
});
</script>


</body>
</html>
