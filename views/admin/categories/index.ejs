<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All Categories</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            bgMain: '#E8FFD7',
            bgCard: '#93DA97',
            accent: '#5E936C',
            textPrimary: '#3E5F44'
          }
        }
      }
    }
  </script>
  <link href="https://unpkg.com/tabulator-tables@6.0.0/dist/css/tabulator.min.css" rel="stylesheet">
</head>

<body class="bg-bgMain text-textPrimary min-h-screen flex flex-col">

  <main class="flex-grow p-4">
    <div class="max-w-7xl mx-auto">

      <!-- Header & Add Button -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <h1 class="text-3xl font-bold flex items-center gap-2">
          <i class="fa fa-gears"></i> All Categories
        </h1>
        <a href="/admin/add-category"
          class="bg-accent text-white px-4 py-2 rounded hover:bg-textPrimary transition w-full md:w-auto text-center">
          Add New Category
        </a>
      </div>

      <div class="flex justify-center">
  <div class="bg-bgCard rounded-lg shadow p-4 overflow-x-auto" style="max-width: 1200px;">
    <div id="categoriesTable"></div>
  </div>
</div>




    </div>
  </main>

  <script src="https://unpkg.com/tabulator-tables@6.0.0/dist/js/tabulator.min.js"></script>


<script>
  const tableData = <%- JSON.stringify(categories) %>;

  let table = new Tabulator("#categoriesTable", {
    data: tableData,
    layout: "fitDataTable", // fits data, expands to container if needed
    responsiveLayout: false,
    pagination: true,
    paginationSize: 10,
    paginationSizeSelector: [5, 10, 25, 50, 100],
    autoResize: true,
    resizableColumns: true,
    rowFormatter: function (row) {
      const index = row.getPosition(true);
      row.getElement().style.backgroundColor = index % 2 === 0 ? "#93DA97" : "#C2E8C5";
      row.getElement().style.color = "#3E5F44";

      row.getElement().addEventListener("mouseenter", () => {
        row.getElement().style.backgroundColor = "#5E936C";
        row.getElement().style.color = "#fff";
      });
      row.getElement().addEventListener("mouseleave", () => {
        row.getElement().style.backgroundColor = index % 2 === 0 ? "#93DA97" : "#C2E8C5";
        row.getElement().style.color = "#3E5F44";
      });
    },
    columns: [
      { title: "S.No.", formatter: "rownum", hozAlign: 'center', minWidth: 80 },
      { title: "Category Name", field: "name", headerFilter: 'input', minWidth: 250 },
      { title: "Slug", field: "slug", headerFilter: 'input', minWidth: 250 },
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        minWidth: 200,
        formatter: (cell) => {
          const id = cell.getRow().getData()._id;
          return `
            <div class="flex flex-row gap-1 justify-center">
              <a href="/admin/update-category/${id}"
                class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700 transition">Edit</a>
              <button onclick="deleteCategory('${id}')"
                class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700 transition">Delete</button>
            </div>
          `;
        }
      }
    ],
  });

  async function deleteCategory(id) {
    if (confirm("Are you sure to delete this Category?")) {
      const response = await fetch(`/admin/delete-category/${id}`, { method: "DELETE" });
      if (response.ok) {
        window.location.reload();
      } else if (response.status === 400) {
        const data = await response.json();
        alert(data.message);
      } else {
        alert("Failed to delete category.");
      }
    }
  }
</script>




</body>

</html>