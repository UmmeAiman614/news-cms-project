<!-- post-container -->
<div class="post-container bg-bgMain p-4 rounded-lg shadow-md">
  <div class="post-content single-post space-y-4">
    <h3 class="text-2xl font-bold text-textPrimary"><%= singleNews.title %></h3>
    
    <div class="post-information text-sm text-textPrimary flex flex-wrap gap-4">
      <span>
        <i class="fa fa-tags" aria-hidden="true"></i>
        <a href="/category/<%= singleNews.category.slug %>" class="hover:text-accent transition"><%= singleNews.category.name %></a>
      </span>
      <span>
        <i class="fa fa-user" aria-hidden="true"></i>
        <a href='/author/<%= singleNews.author._id %>' class="hover:text-accent transition"><%= singleNews.author.fullname %></a>
      </span>
      <span>
        <i class="fa fa-calendar" aria-hidden="true"></i>
        <% var date = new Date(singleNews.createdAt); %>
        <%= date.toLocaleDateString("en-US", { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
      </span>
    </div>

    <img class="single-feature-image rounded-lg shadow-md" src="/uploads/<%= singleNews.image %>" alt=""/>

    <div class="text-textPrimary">
      <%- singleNews.content %>
    </div>
  </div>
</div>
<!-- /post-container -->

<!-- Comments Section -->
<div class="comments-section mt-6 space-y-4">
  <h3 class="text-xl font-semibold text-textPrimary">Comments</h3>
  
  <!-- Comment Form -->
  <div class="bg-bgCard p-4 rounded-lg shadow-md">
    <form action="/single/<%= singleNews._id %>/comment" method="POST" class="space-y-3">
      <div>
        <label class="block mb-1 font-medium text-textPrimary">Name</label>
        <input type="text" class="w-full px-3 py-2 rounded border border-green-700 focus:outline-none focus:ring-2 focus:ring-accent" name="name" required>
      </div>
      <div>
        <label class="block mb-1 font-medium text-textPrimary">Email</label>
        <input type="email" class="w-full px-3 py-2 rounded border border-green-700 focus:outline-none focus:ring-2 focus:ring-accent" name="email" required>
      </div>
      <div>
        <label class="block mb-1 font-medium text-textPrimary">Comment</label>
        <textarea class="w-full px-3 py-2 rounded border border-green-700 focus:outline-none focus:ring-2 focus:ring-accent" name="content" rows="3" required></textarea>
      </div>
      <button type="submit" class="bg-accent text-white px-4 py-2 rounded hover:bg-textPrimary transition">Submit Comment</button>
    </form>
  </div>

  <!-- Display Comments -->
  <div class="comments-list space-y-3">
    <% comments.forEach(function(comment) { %>
      <div class="bg-bgCard p-3 rounded-lg shadow-md">
        <h6 class="font-semibold text-textPrimary mb-1"><%= comment.name %></h6>
        <p class="text-textPrimary mb-1"><%= comment.content %></p>
        <small class="text-textPrimary">Posted on <%= new Date(comment.createdAt).toLocaleDateString("en-US", { year: 'numeric', month: 'long', day: 'numeric' }) %></small>
      </div>
    <% }); %>
  </div>
</div>
